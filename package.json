{
	"name": "openplanetarium",
	"displayName": "Openplanetarium",
	"description": "Language server for Openplanet's Angelscript",
	"version": "0.0.0",
	"publisher": "Ezio416",
	"engines": {
		"vscode": "^1.126.0"
	},
	"activationEvents": [],
	"main": "./out/extension.js",
	"categories": [
		"Programming Languages"
	],
	"devDependencies": {
		"@types/node": "^24.x",
		"@types/vscode": "^1.126.0",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile",
		"test": "vscode-test"
	},
	"contributes": {
		"commands": [
			{
				"command": "openplanetarium.helloWorld",
				"title": "Hello World"
			}
		],
		"configuration": [
			{
				"title": "Openplanetarium",
				"properties": {
					"openplanetarium.OpenplanetNextFolder": {
						"order": 0,
						"type": "string",
						"default": "",
						"markdownDescription": "Path to OpenplanetNext folder.\n\nTypically: `C:/Users/<USERNAME>/OpenplanetNext/`"
					},
					"openplanetarium.TrackmaniaNextInstallFolder": {
						"order": 1,
						"type": "string",
						"default": "",
						"markdownDescription": "Path to Trackmania (2020) install folder.\n\nTypically: `C:/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/games/Trackmania/`"
					}
				}
			}
		],
		"languages": [
			{
				"id": "angelscript",
				"aliases": [
					"Angelscript",
					"angelscript"
				],
				"extensions": [
					".as"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "angelscript",
				"scopeName": "source.angelscript",
				"path": "./syntaxes/angelscript.tmLanguage.json"
			}
		]
	}
}
